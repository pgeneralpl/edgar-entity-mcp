# REQUIRED by SEC fair-access policy: identify yourself with a name/company and contact email.
# SEC tools refuse to run while this is unset or a placeholder.
SEC_USER_AGENT="Acme Research jane@acme.com"

# Optional: upstream request rates (per process, and fleet-wide with Redis). SEC limit is 10/s.
# SEC_MAX_RPS=6          # default 6, hard max 8
# SOCRATA_MAX_RPS=5
# DISTRIBUTED_RATE_LIMIT=1   # 0 disables the Redis token buckets

# Optional: Socrata app token for state registries (higher throttling limits)
# SOCRATA_APP_TOKEN=

# Optional: shared cache, fleet-wide rate budget and quotas (recommended on Vercel)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# HTTP quotas (units; see README "Hosted quotas")
# QUOTA_ANON_PER_MINUTE=30
# QUOTA_ANON_PER_DAY=60
# QUOTA_ANON_GLOBAL_PER_DAY=600         # soft cap shared by ALL anonymous callers
# QUOTA_ANON_GLOBAL_HARD_PER_DAY=900    # hard ceiling (soft cap + per-IP trickle)
# QUOTA_ANON_TRICKLE_PER_DAY=10         # per IP once the soft cap is spent
# QUOTA_ANON_NETWORK_PER_DAY=60         # per /24 (IPv6 /48); default 4x QUOTA_ANON_PER_DAY, at most 10% of the global cap
# QUOTA_KEY_PER_MINUTE=120
# QUOTA_KEY_PER_DAY=500
# SEC_KEYED_RESERVED_RPS=2          # part of SEC_MAX_RPS reserved for API-key callers
# MAX_CONCURRENT_UPSTREAM_PER_CLIENT=4
# DEGRADED_SEC_RPS=0.2              # SEC rate for API-key callers while Redis is unavailable; 0 = refuse
# KEY_REQUEST_URL=https://github.com/pgeneralpl/edgar-entity-mcp/issues/new?template=higher-limits.yml
# REQUIRED when Redis is configured (server refuses to start otherwise): >= 32 random chars,
# e.g. `openssl rand -hex 32`. IP hashes use a daily-rotating keyed hash (keyed with IP_HASH_SALT).
# IP_HASH_SALT=
# REQUIRED when Redis is configured: >= 32 random chars, different from IP_HASH_SALT.
# Signs API keys eem_<id>_<HMAC>; rotating it revokes every minted key.
# API_KEY_SECRET=
# Immediate revocation without Redis (comma-separated key ids or keys):
# REVOKED_KEY_IDS=

# API keys: static keys (comma-separated) in addition to keys minted with scripts/create-key.ts
# (delete with scripts/delete-key.ts)
# MCP_API_KEYS=eem_xxx
# MCP_REQUIRE_API_KEY=1   # reject anonymous HTTP calls

# /health?deep=1 requires header x-health-secret: <HEALTH_SECRET> (HTTP 401 otherwise, and always while unset)
# HEALTH_SECRET=

# Privacy: JSON array of "entity:<STATE>:<id>" / "agent:<name>" entries to suppress
# SUPPRESSION_FILE=./suppressions.json

# Self-hosted node server
# HOST=127.0.0.1
# ALLOWED_HOSTS=mcp.example.com
# ALLOWED_ORIGINS=https://app.example.com
# TRUST_PROXY=1

# Aggregate daily usage counters in Redis (on by default when Upstash is configured, including
# self-hosted HTTP servers; on Vercel only VERCEL_ENV=production writes them; kept 30 days after each UTC day)
# Set STATS_ENABLED=false to turn them off.
# STATS_ENABLED=0
# Enables GET /stats?days=N with header x-stats-secret (>= 32 chars, openssl rand -hex 32); otherwise 404
# STATS_SECRET=

# Optional: log per-call usage JSON to stderr (no arguments, keys or raw IPs)
# USAGE_LOG=1

# Tuning
# MEMORY_CACHE_MB=128
# REDIS_MAX_VALUE_BYTES=900000
# HTTP_TIMEOUT_MS=25000
# MAX_BODY_BYTES=65536
# MAX_DOCUMENT_BYTES=15728640
# CACHE_PREFIX=eem:v1:
