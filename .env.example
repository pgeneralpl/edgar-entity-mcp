# REQUIRED by SEC fair-access policy: identify yourself with a name/company and contact email.
SEC_USER_AGENT="Acme Research jane@acme.com"

# Optional: SEC request rate cap per process (default 8, hard max 9; SEC limit is 10/s)
# SEC_MAX_RPS=8

# Optional: Socrata app token for state registries (higher rate limits)
# SOCRATA_APP_TOKEN=

# Optional: shared cache + fleet-wide SEC rate budget (recommended on Vercel)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# SEC_DISTRIBUTED_RATE_LIMIT=1   # set 0 to disable the Redis-based global limiter

# Optional: require API keys on the HTTP endpoint (comma-separated). Unset = open/free tier.
# MCP_API_KEYS=key_live_abc,key_live_def

# Optional: log per-call usage JSON to stderr (tool, ms, ok, response size, key prefix)
# USAGE_LOG=1

# Tuning
# MEMORY_CACHE_MB=128
# REDIS_MAX_VALUE_BYTES=900000
# HTTP_TIMEOUT_MS=25000
# CACHE_PREFIX=eem:v1:
